meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/llm-proxy
  timeout: 3000
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("health payload reports ok", function() {
    const body = res.getBody();
    expect(body).to.have.property("status", "ok");
    expect(body).to.have.property("message", "LLM Proxy is running");
  });

  test("health payload lists supported providers", function() {
    const body = res.getBody();
    expect(body.supportedProviders).to.be.an("array");
    expect(body.supportedProviders).to.include("openrouter");
  });
}
